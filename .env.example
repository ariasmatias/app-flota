# Propuesta de configuración del backend. Sin credenciales reales.
APP_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_flota
DB_USER=
DB_PASSWORD=
# Integraciones simuladas durante desarrollo
INTEGRATIONS_MODE=mock
AUTH_MODE=development
# Generar un secreto aleatorio local (>=32 bytes). Nunca versionar su valor real.
SESSION_SECRET=
# Vencimiento por inactividad (minutos, entero entre 1 y 1440).
SESSION_IDLE_MINUTES=30
# Solo development puede usar false. Fuera de development, HTTPS y true obligatorios.
SESSION_COOKIE_SECURE=false
SQLSERVER_HOST=
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Ruta local configurable, fuera de Git
UPLOADS_DIR=./uploads
# AUTH_MODE=development es exclusivo de desarrollo.
# Las variables privadas no deben exponerse al frontend.
