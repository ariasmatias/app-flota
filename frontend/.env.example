# Copiar como .env.local (ignorado por Git).
# development = usuario simulado con selector "Ver como", sin Active Directory.
# real        = la sesión se pide al backend (GET /api/sesion).
# Si no se define: `npm run dev` usa development y `npm run build` usa real.
VITE_AUTH_MODE=development

# Ninguna variable VITE_ es secreta: todas terminan dentro del JavaScript que
# descarga el navegador. Credenciales y conexiones van SOLO en el backend.
